# Скопируйте в .env.local и заполните. Без ключей приложение тоже работает:
# анализ текста — эвристикой, озвучка — голосом браузера, хранение — в IndexedDB.

# Gemini (серверный ключ, в браузер не попадает) — https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_TTS_MODEL=gemini-3.8-flash-tts

# Supabase (общий архив для демо). Схема — supabase/schema.sql
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
