# Скопируйте в .env.local и заполните. Без ключей приложение тоже работает:
# анализ текста — эвристикой, хранение — в IndexedDB.

# Gemini (серверный ключ, в браузер не попадает) — https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash

# Supabase — аккаунты: у каждого свой дневник в облаке. Схема — supabase/schema.sql (SQL Editor).
# Ключ publishable (sb_publishable_…) или старый anon — он рассчитан на браузер, данные закрыты RLS.
# Без этих строк кнопки «войти» нет, дневник живёт в IndexedDB браузера.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
